@page "/admin/hampers"
@using HamperStore.Core.Entities
@using HamperStore.Core.Interfaces
@using System.IO
@inject HamperStore.Web.Services.UserSessionService UserSession
@inject NavigationManager Navigation
@inject IHamperRepository HamperRepo
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject HamperStore.Web.Services.GitHubSyncService GitHubSync
@rendermode InteractiveServer

<PageTitle>Manage Catalog - Admin</PageTitle>

<div class="container-custom py-5">
    @if (!UserSession.IsAdmin)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Redirecting...</span>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="mb-1" style="font-size: 2.2rem;">Store Catalog Management</h1>
                <p class="text-muted mb-0">List new hampers, update existing pricing, modify items, toggle active status, and add new categories</p>
            </div>
            <div class="d-flex gap-2">
                <button @onclick="OpenAddCategoryModal" class="btn-card-secondary" style="width: auto; padding: 0.6rem 1.2rem;">
                    <i class="bi bi-folder-plus"></i> Add Category
                </button>
                <button @onclick="OpenAddHamperModal" class="btn-card-primary" style="width: auto; padding: 0.6rem 1.2rem;">
                    <i class="bi bi-plus-circle-fill"></i> List New Hamper
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="alert alert-success alert-dismissible fade show small" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                @statusMessage
                <button type="button" class="btn-close" @onclick="() => statusMessage = null" aria-label="Close" style="background: none; border: none; float: right; font-size: 1.25rem; font-weight: bold; line-height: 1; color: #000; text-shadow: 0 1px 0 #fff; opacity: .5;"></button>
            </div>
        }

        <!-- Hampers Catalog Table -->
        <div class="admin-table-card">
            <div class="admin-table-header">
                <h2>All Catalog Hampers</h2>
                <div class="d-flex gap-3 align-items-center">
                    <label for="categoryFilter" class="small text-muted mb-0">Filter by Category:</label>
                    <select id="categoryFilter" class="status-select" @bind="selectedCategoryFilter" @bind:after="ApplyFilter">
                        <option value="All">All Categories</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id.ToString()">@cat.Name</option>
                        }
                    </select>
                </div>
            </div>

            @if (filteredHampers == null)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-success" role="status">
                        <span class="visually-hidden">Loading catalog...</span>
                    </div>
                </div>
            }
            else if (!filteredHampers.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-box-seam" style="font-size: 3rem; display: block; margin-bottom: 1rem; color: var(--accent);"></i>
                    <p>No hampers listed in this category.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>Hamper Name</th>
                                <th>Category</th>
                                <th>Base Price</th>
                                <th>Cities</th>
                                <th>Customizable</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var hamper in filteredHampers)
                            {
                                <tr id="hamper-row-@hamper.Id">
                                    <td style="width: 80px;">
                                        @if (hamper.Images != null && hamper.Images.Any())
                                        {
                                            <img src="@hamper.Images.First(i => i.IsPrimary).ImageUrl" alt="@hamper.Name" style="width: 60px; height: 60px; object-fit: cover; border-radius: 4px; border: 1px solid var(--border-color);" />
                                        }
                                        else
                                        {
                                            <div style="width: 60px; height: 60px; background: #eef1ef; display: flex; align-items: center; justify-content: center; border-radius: 4px; color: var(--text-muted);"><i class="bi bi-image"></i></div>
                                        }
                                    </td>
                                    <td>
                                        <strong>@hamper.Name</strong><br/>
                                        <span class="small text-muted" style="display:-webkit-box; -webkit-line-clamp:1; -webkit-box-orient:vertical; overflow:hidden;">@hamper.Description</span>
                                    </td>
                                    <td><span class="badge text-white" style="background-color: var(--primary-light); padding: 0.35rem 0.6rem; border-radius: 4px; font-weight: 500;">@hamper.Category.Name</span></td>
                                    <td><strong>₹@hamper.BasePrice.ToString("F0")</strong></td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var city in hamper.AvailableCities)
                                            {
                                                <span class="small text-muted" style="background: rgba(13, 44, 36, 0.05); padding: 0.15rem 0.4rem; border-radius: 3px;">@city.Name</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (hamper.IsCustomizable)
                                        {
                                            <span class="text-success small"><i class="bi bi-check-circle-fill"></i> Yes</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><i class="bi bi-dash-circle"></i> No</span>
                                        }
                                    </td>
                                    <td>
                                        @if (hamper.IsActive)
                                        {
                                            <span class="badge" style="background-color: rgba(38, 176, 80, 0.15); color: #26b050; padding: 0.35rem 0.6rem; border-radius: 4px; font-weight: 600;">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background-color: rgba(220, 53, 69, 0.15); color: #dc3545; padding: 0.35rem 0.6rem; border-radius: 4px; font-weight: 600;">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <button @onclick="() => EditHamper(hamper)" class="btn-card-secondary" style="width: auto; padding: 0.4rem 0.8rem; margin: 0;">
                                                <i class="bi bi-pencil-fill"></i> Edit
                                            </button>
                                            <button @onclick="() => ToggleHamperStatusAsync(hamper)" 
                                                    class="btn-form-submit" 
                                                    style="width: auto; padding: 0.4rem 0.8rem; margin: 0; background-color: @(hamper.IsActive ? "#dc3545" : "#26b050"); border-color: @(hamper.IsActive ? "#dc3545" : "#26b050"); color: white !important;">
                                                @(hamper.IsActive ? "Take Down" : "Activate")
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

<!-- Modal: Add/Edit Hamper -->
@if (showHamperModal)
{
    <div class="modal-backdrop-custom" @onclick="CloseHamperModal">
        <div class="modal-content-custom" @onclick:stopPropagation style="max-width: 700px;">
            <div class="modal-header-custom">
                <h3>@(editingHamperId.HasValue ? "Edit Catalog Hamper" : "List New Hamper")</h3>
                <button @onclick="CloseHamperModal" class="btn-close-custom">&times;</button>
            </div>
            <EditForm Model="hamperFormModel" OnValidSubmit="SaveHamperAsync">
                <div class="modal-body-custom" style="max-height: 75vh; overflow-y: auto;">
                    @if (!string.IsNullOrEmpty(hamperModalError))
                    {
                        <div class="alert alert-danger small p-2">@hamperModalError</div>
                    }

                    <div class="form-grid">
                        <div class="form-group-custom">
                            <label for="hamperName">Hamper Name *</label>
                            <input type="text" id="hamperName" class="form-control-custom" placeholder="e.g. Premium Saffron Delight" @bind="tempName" required />
                        </div>

                        <div class="form-group-custom">
                            <label for="hamperPrice">Base Price (₹) *</label>
                            <input type="number" id="hamperPrice" class="form-control-custom" placeholder="e.g. 1299" @bind="tempBasePrice" min="0" required />
                        </div>

                        <div class="form-group-custom">
                            <label for="hamperCategory">Category / Occasion *</label>
                            <select id="hamperCategory" class="form-control-custom" @bind="tempCategoryId" required>
                                <option value="0">Select Category</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                        </div>

                        <div class="form-group-custom" style="display: flex; align-items: center; justify-content: start; gap: 0.75rem; margin-top: 1.5rem;">
                            <input type="checkbox" id="hamperCustomizable" style="width: 18px; height: 18px; cursor: pointer;" @bind="tempIsCustomizable" />
                            <label for="hamperCustomizable" style="margin-bottom: 0; cursor: pointer; font-weight: 600;">Customizable by Customer</label>
                        </div>

                        <div class="form-group-custom full-width">
                            <label for="hamperDescription">Hamper Description</label>
                            <textarea id="hamperDescription" class="form-control-custom" rows="2" placeholder="Describe the packaging style and general presentation..." @bind="tempDescription"></textarea>
                        </div>

                        <div class="form-group-custom full-width">
                            <label>Available in Cities *</label>
                            <div class="d-flex gap-4 mt-2">
                                @foreach (var city in cities)
                                {
                                    <div style="display: flex; align-items: center; gap: 0.4rem;">
                                        <input type="checkbox" id="city-@city.Id" style="width: 16px; height: 16px;" 
                                               checked="@tempSelectedCityIds.Contains(city.Id)"
                                               @onchange="(e) => ToggleCitySelection(city.Id, e.Value)" />
                                        <label for="city-@city.Id" style="margin-bottom: 0; font-weight: 500;">@city.Name</label>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="form-group-custom full-width">
                            <label for="hamperImage">Product Image</label>
                            <InputFile id="hamperImage" class="form-control-custom" OnChange="HandleImageSelected" accept=".jpg,.jpeg,.png,.webp" />
                            <span class="small text-muted"><i class="bi bi-info-circle"></i> Select an image from your device. Supported formats: JPG, PNG, WEBP.</span>
                            
                            @if (!string.IsNullOrEmpty(imagePreviewUrl) || !string.IsNullOrEmpty(tempImageUrl))
                            {
                                <div class="mt-3 p-2 border rounded text-center" style="background-color: var(--bg-cream); max-width: 220px;">
                                    <span class="small text-muted d-block mb-1">Image Preview:</span>
                                    <img src="@(!string.IsNullOrEmpty(imagePreviewUrl) ? imagePreviewUrl : tempImageUrl)" alt="Product Preview" style="max-width: 100%; max-height: 150px; object-fit: contain; border-radius: 4px;" />
                                </div>
                            }
                        </div>

                        <div class="form-group-custom full-width">
                            <label for="hamperItems">Included Standard Items (One item per line)</label>
                            <textarea id="hamperItems" class="form-control-custom" rows="5" placeholder="e.g.&#10;Gourmet Coffee Mug&#10;Ferrero Rocher Box (16 Pcs)&#10;Tilak Roli Packet" @bind="tempItemsText"></textarea>
                            <span class="small text-muted"><i class="bi bi-info-circle"></i> Enter each item on a new line. Standard prices for these items are treated as 0.</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer-custom">
                    <button type="button" @onclick="CloseHamperModal" class="btn-card-secondary" style="width: auto;">Cancel</button>
                    <button type="submit" class="btn-card-primary" style="width: auto;">Save Hamper</button>
                </div>
            </EditForm>
        </div>
    </div>
}

<!-- Modal: Add Category -->
@if (showCategoryModal)
{
    <div class="modal-backdrop-custom" @onclick="CloseCategoryModal">
        <div class="modal-content-custom" @onclick:stopPropagation style="max-width: 500px;">
            <div class="modal-header-custom">
                <h3>Add New Occasion Category</h3>
                <button @onclick="CloseCategoryModal" class="btn-close-custom">&times;</button>
            </div>
            <EditForm Model="categoryFormModel" OnValidSubmit="SaveCategoryAsync">
                <div class="modal-body-custom">
                    @if (!string.IsNullOrEmpty(categoryModalError))
                    {
                        <div class="alert alert-danger small p-2">@categoryModalError</div>
                    }

                    <div class="form-group-custom mb-3">
                        <label for="catName">Category Name *</label>
                        <input type="text" id="catName" class="form-control-custom" placeholder="e.g. Diwali Hampers" @bind="newCategoryName" required />
                    </div>

                    <div class="form-group-custom mb-3">
                        <label for="catDesc">Description</label>
                        <textarea id="catDesc" class="form-control-custom" rows="3" placeholder="Describe the occasion or standard products included in this range..." @bind="newCategoryDescription"></textarea>
                    </div>
                </div>
                <div class="modal-footer-custom">
                    <button type="button" @onclick="CloseCategoryModal" class="btn-card-secondary" style="width: auto;">Cancel</button>
                    <button type="submit" class="btn-card-primary" style="width: auto;">Add Category</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<Hamper> allHampers = new();
    private List<Hamper> filteredHampers = new();
    private List<Category> categories = new();
    private List<City> cities = new();

    private string? statusMessage;
    private string selectedCategoryFilter = "All";

    // Form Models (dummies for EditForm validation triggers)
    private object hamperFormModel = new();
    private object categoryFormModel = new();

    // Modal Control Flags
    private bool showHamperModal = false;
    private bool showCategoryModal = false;

    // Add/Edit Hamper Fields
    private int? editingHamperId;
    private string tempName = string.Empty;
    private string tempDescription = string.Empty;
    private decimal tempBasePrice;
    private int tempCategoryId;
    private bool tempIsCustomizable;
    private string tempImageUrl = string.Empty;
    private string tempItemsText = string.Empty;
    private List<int> tempSelectedCityIds = new();
    private string? hamperModalError;

    // Image Upload Fields
    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? selectedImageFile;
    private string? imagePreviewUrl;

    // Add Category Fields
    private string newCategoryName = string.Empty;
    private string newCategoryDescription = string.Empty;
    private string? categoryModalError;

    protected override async Task OnInitializedAsync()
    {
        await UserSession.InitializeAsync();
        if (!UserSession.IsAdmin)
        {
            Navigation.NavigateTo("admin/login");
            return;
        }
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        allHampers = await HamperRepo.GetAllAsync(includeInactive: true);
        categories = await HamperRepo.GetCategoriesAsync();
        cities = await HamperRepo.GetCitiesAsync();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (selectedCategoryFilter == "All")
        {
            filteredHampers = allHampers.ToList();
        }
        else
        {
            if (int.TryParse(selectedCategoryFilter, out var catId))
            {
                filteredHampers = allHampers.Where(h => h.CategoryId == catId).ToList();
            }
        }
    }

    private async Task ToggleHamperStatusAsync(Hamper hamper)
    {
        hamper.IsActive = !hamper.IsActive;
        await HamperRepo.UpdateHamperAsync(hamper);
        statusMessage = $"Hamper '{hamper.Name}' status updated successfully to {(hamper.IsActive ? "Active" : "Inactive")}.";
        await LoadDataAsync();
    }

    // Modal Add/Edit Actions
    private void OpenAddHamperModal()
    {
        editingHamperId = null;
        tempName = string.Empty;
        tempDescription = string.Empty;
        tempBasePrice = 0m;
        tempCategoryId = categories.FirstOrDefault()?.Id ?? 0;
        tempIsCustomizable = false;
        tempImageUrl = string.Empty;
        tempItemsText = string.Empty;
        tempSelectedCityIds = cities.Select(c => c.Id).ToList(); // select all by default
        hamperModalError = null;
        selectedImageFile = null;
        imagePreviewUrl = null;

        showHamperModal = true;
    }

    private async Task EditHamper(Hamper hamper)
    {
        editingHamperId = hamper.Id;
        tempName = hamper.Name;
        tempDescription = hamper.Description ?? string.Empty;
        tempBasePrice = hamper.BasePrice;
        tempCategoryId = hamper.CategoryId;
        tempIsCustomizable = hamper.IsCustomizable;
        tempImageUrl = hamper.Images.FirstOrDefault(i => i.IsPrimary)?.ImageUrl ?? string.Empty;
        selectedImageFile = null;
        imagePreviewUrl = null;
        
        // Load items text
        var fullHamper = await HamperRepo.GetByIdAsync(hamper.Id);
        if (fullHamper != null)
        {
            tempItemsText = string.Join(Environment.NewLine, fullHamper.Items.Select(i => i.Name));
            tempSelectedCityIds = fullHamper.AvailableCities.Select(c => c.Id).ToList();
        }
        else
        {
            tempItemsText = string.Empty;
            tempSelectedCityIds = new List<int>();
        }

        hamperModalError = null;
        showHamperModal = true;
    }

    private void ToggleCitySelection(int cityId, object? checkedValue)
    {
        bool isChecked = false;
        if (checkedValue is bool b) isChecked = b;

        if (isChecked)
        {
            if (!tempSelectedCityIds.Contains(cityId))
            {
                tempSelectedCityIds.Add(cityId);
            }
        }
        else
        {
            tempSelectedCityIds.Remove(cityId);
        }
    }

    private void CloseHamperModal()
    {
        showHamperModal = false;
    }

    private async Task HandleImageSelected(InputFileChangeEventArgs e)
    {
        selectedImageFile = e.File;
        hamperModalError = null;

        var extension = Path.GetExtension(selectedImageFile.Name).ToLower();
        var allowedExtensions = new[] { ".jpg", ".jpeg", ".png", ".webp" };
        if (!allowedExtensions.Contains(extension))
        {
            hamperModalError = "Please select a valid image file (.jpg, .jpeg, .png, .webp).";
            selectedImageFile = null;
            imagePreviewUrl = null;
            return;
        }

        if (selectedImageFile.Size > 5 * 1024 * 1024)
        {
            hamperModalError = "Selected image file size exceeds the 5MB limit.";
            selectedImageFile = null;
            imagePreviewUrl = null;
            return;
        }

        try
        {
            var format = selectedImageFile.ContentType;
            var resizedImageFile = await selectedImageFile.RequestImageFileAsync(format, 400, 400);
            var buffer = new byte[resizedImageFile.Size];
            using (var stream = resizedImageFile.OpenReadStream())
            {
                await stream.ReadAsync(buffer);
            }
            imagePreviewUrl = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error creating image preview: {ex.Message}");
            imagePreviewUrl = null;
        }
    }

    private async Task SaveHamperAsync()
    {
        if (tempCategoryId <= 0)
        {
            hamperModalError = "Please select a category.";
            return;
        }

        if (!tempSelectedCityIds.Any())
        {
            hamperModalError = "Please check at least one delivery city.";
            return;
        }

        // Generate clean URL slug
        var slug = tempName.ToLower()
            .Replace(" ", "-")
            .Replace("&", "and")
            .Replace("/", "-")
            .Replace("\\", "-");
        slug = new string(slug.Where(c => char.IsLetterOrDigit(c) || c == '-').ToArray());

        // Standard items parse
        var itemNames = tempItemsText
            .Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.Trim())
            .Where(s => !string.IsNullOrEmpty(s))
            .ToList();

        var itemEntities = itemNames.Select(name => new HamperItem { Name = name, Price = 0m }).ToList();

        // Cities mapping
        var selectedCityEntities = cities.Where(c => tempSelectedCityIds.Contains(c.Id)).ToList();

        // Handle file saving if selected
        if (selectedImageFile != null)
        {
            try
            {
                var uploadsDir = Path.Combine(Env.WebRootPath, "images", "hampers", "uploads");
                if (!Directory.Exists(uploadsDir))
                {
                    Directory.CreateDirectory(uploadsDir);
                }

                var uniqueFileName = Guid.NewGuid().ToString() + Path.GetExtension(selectedImageFile.Name);
                var savePath = Path.Combine(uploadsDir, uniqueFileName);

                byte[] fileBytes;
                using (var memoryStream = new MemoryStream())
                {
                    await selectedImageFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(memoryStream);
                    fileBytes = memoryStream.ToArray();
                }

                await File.WriteAllBytesAsync(savePath, fileBytes);

                // Sync the image file in background
                _ = Task.Run(() => GitHubSync.SyncFileAsync($"wwwroot/images/hampers/uploads/{uniqueFileName}", fileBytes));

                tempImageUrl = $"/images/hampers/uploads/{uniqueFileName}";
            }
            catch (Exception ex)
            {
                hamperModalError = $"Failed to save image file: {ex.Message}";
                return;
            }
        }

        // Image mapping
        var primaryImage = new HamperImage
        {
            ImageUrl = string.IsNullOrWhiteSpace(tempImageUrl) ? "/images/hampers/Full_Collage.png" : tempImageUrl,
            IsPrimary = true,
            SortOrder = 1
        };

        if (editingHamperId.HasValue)
        {
            var existing = await HamperRepo.GetByIdAsync(editingHamperId.Value);
            if (existing != null)
            {
                existing.Name = tempName;
                existing.Slug = slug;
                existing.Description = tempDescription;
                existing.BasePrice = tempBasePrice;
                existing.CategoryId = tempCategoryId;
                existing.IsCustomizable = tempIsCustomizable;
                existing.AvailableCities = selectedCityEntities;
                existing.Items = itemEntities;
                
                // Add the image
                primaryImage.HamperId = existing.Id;
                existing.Images = new List<HamperImage> { primaryImage };

                await HamperRepo.UpdateHamperAsync(existing);
                statusMessage = $"Hamper '{tempName}' updated successfully in the catalog.";
            }
        }
        else
        {
            var newHamper = new Hamper
            {
                Name = tempName,
                Slug = slug,
                Description = tempDescription,
                BasePrice = tempBasePrice,
                CategoryId = tempCategoryId,
                IsCustomizable = tempIsCustomizable,
                IsActive = true,
                AvailableCities = selectedCityEntities,
                Items = itemEntities,
                Images = new List<HamperImage> { primaryImage }
            };

            await HamperRepo.AddHamperAsync(newHamper);
            statusMessage = $"New Hamper '{tempName}' listed successfully in the catalog.";
        }

        CloseHamperModal();
        await LoadDataAsync();
    }

    // Category modal actions
    private void OpenAddCategoryModal()
    {
        newCategoryName = string.Empty;
        newCategoryDescription = string.Empty;
        categoryModalError = null;
        showCategoryModal = true;
    }

    private void CloseCategoryModal()
    {
        showCategoryModal = false;
    }

    private async Task SaveCategoryAsync()
    {
        if (string.IsNullOrWhiteSpace(newCategoryName))
        {
            categoryModalError = "Category Name is required.";
            return;
        }

        // Generate Category Slug
        var slug = newCategoryName.ToLower()
            .Replace(" ", "-")
            .Replace("&", "and")
            .Replace("/", "-")
            .Replace("\\", "-");
        slug = new string(slug.Where(c => char.IsLetterOrDigit(c) || c == '-').ToArray());

        // Check if slug already exists
        if (categories.Any(c => c.Slug == slug))
        {
            categoryModalError = "A category with a similar name already exists.";
            return;
        }

        var newCat = new Category
        {
            Name = newCategoryName,
            Slug = slug,
            Description = newCategoryDescription
        };

        await HamperRepo.AddCategoryAsync(newCat);
        statusMessage = $"New category '{newCategoryName}' created successfully. It is now visible across the application.";

        CloseCategoryModal();
        await LoadDataAsync();
    }
}
